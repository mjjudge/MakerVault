# MakerVault — Environment Variables
# Copy this file to .env and fill in the required values before running.
#
#   cp infra/docker/.env.example infra/docker/.env
#
# The .env file is excluded from version control. Never commit real secrets.

# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------

# Database superuser name (default: makervault)
POSTGRES_USER=makervault

# REQUIRED: set a strong password before first run
POSTGRES_PASSWORD=

# Database name (default: makervault)
POSTGRES_DB=makervault

# -----------------------------------------------------------------------------
# API
# -----------------------------------------------------------------------------

# REQUIRED: a random secret used for signing session tokens / JWTs
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# -----------------------------------------------------------------------------
# Nginx
# -----------------------------------------------------------------------------

# Host port nginx listens on for HTTP traffic (default: 80)
NGINX_HTTP_PORT=80

# -----------------------------------------------------------------------------
# AI provider secrets
# Leave blank if not using a hosted provider.
# These are passed to the api service as environment variables; they are never
# stored in the database.
# -----------------------------------------------------------------------------

# OpenAI API key (leave blank if not using OpenAI)
OPENAI_API_KEY=

# Anthropic API key (leave blank if not using Anthropic)
ANTHROPIC_API_KEY=

# Custom OpenAI-compatible endpoint (e.g. for DeepSeek or a local proxy)
AI_PROVIDER_BASE_URL=

# -----------------------------------------------------------------------------
# Document storage
# The documents volume is managed by Docker Compose and mounted into the api
# and worker containers at /data/makervault/documents.
# No path override is needed here unless you replace the named volume with a
# bind mount (see docker-compose.yml for instructions).
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# Backups
# -----------------------------------------------------------------------------

# Directory where backup archives are written inside the containers.
# Override to point at a separate physical disk or network mount.
# Example (separate disk mounted at /mnt/backups on the host):
#   BACKUP_PATH=/mnt/backups/makervault
BACKUP_PATH=/data/makervault/backups

# How many completed backups of each type (db / documents / full) to keep.
# Older backups beyond this count are deleted when pruning runs.
# Set to 0 to disable automatic pruning.
BACKUP_RETENTION_COUNT=10
